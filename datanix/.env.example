# Copy these values into your environment/server config. Never commit real secrets.
DATANIX_DB_HOST=127.0.0.1
DATANIX_DB_NAME=datanix
DATANIX_DB_USER=datanix_app
DATANIX_DB_PASSWORD=REPLACE_WITH_A_GENERATED_PASSWORD
DATANIX_TIMEZONE=Asia/Jakarta
APP_BASE_URL=
# Generate 32 random bytes, hex-encoded, e.g. php -r 'echo bin2hex(random_bytes(32));'
APP_ENCRYPTION_KEY=
# Optional OpenAI-compatible endpoint and model. Keys must stay server-side only.
AI_PROVIDER=openai-compatible
AI_API_BASE=
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=25
# Optional comma-separated hosts that operators have explicitly approved for SQL/API connectors.
CONNECTOR_HOST_ALLOWLIST=
# Only enable local/private connector targets on an isolated development machine.
CONNECTOR_ALLOW_PRIVATE_NETWORK=false
# Local mail transport is required to deliver forgotten-password links.
MAIL_FROM=datanix@localhost
APP_ENV=production
