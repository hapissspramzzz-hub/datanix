Options -Indexes
RewriteEngine On
RewriteRule ^(?:config|includes|database|storage|uploads)/ - [F,L,NC]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteCond %{REQUEST_URI} ^/api(?:/|$) [NC]
RewriteRule ^api/?(.*)$ api/index.php?path=$1 [QSA,L]
<FilesMatch "^(?:\.env(?:\..*)?|README\.md|TODO\.md|plan\.md)$">
  Require all denied
</FilesMatch>
